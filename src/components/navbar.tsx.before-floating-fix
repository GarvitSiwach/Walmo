"use client";

import React, { useState, useEffect } from "react";
import Link from "next/link";
import { siteConfig } from "@/config/site";
import { Logo } from "@/components/logo";
import { ThemeToggle } from "@/components/theme-toggle";
import { Menu, X, ArrowUpRight } from "lucide-react";

export function Navbar() {
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);
  const [scrolled, setScrolled] = useState(false);

  useEffect(() => {
    const handleScroll = () => {
      setScrolled(window.scrollY > 20);
    };
    window.addEventListener("scroll", handleScroll, { passive: true });
    return () => window.removeEventListener("scroll", handleScroll);
  }, []);

  // Close mobile menu on Escape key
  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === "Escape") setMobileMenuOpen(false);
    };
    window.addEventListener("keydown", handleKeyDown);
    return () => window.removeEventListener("keydown", handleKeyDown);
  }, []);

  // Prevent background scroll when mobile menu is open
  useEffect(() => {
    if (mobileMenuOpen) {
      document.body.style.overflow = "hidden";
    } else {
      document.body.style.overflow = "";
    }
    return () => {
      document.body.style.overflow = "";
    };
  }, [mobileMenuOpen]);

  return (
    <header
      className={`sticky top-0 z-50 w-full px-4 sm:px-6 transition-all duration-500 ease-in-out ${
        scrolled ? "pt-3 pb-2" : "pt-4 pb-2 sm:pt-5 sm:pb-3"
      }`}
    >
      <div
        className={`relative mx-auto flex items-center justify-between transition-all duration-500 ease-in-out ${
          scrolled
            ? "max-w-[1120px] rounded-full border border-border/70 bg-background/90 px-4 py-2 shadow-lg shadow-black/[0.06] backdrop-blur-xl sm:px-6"
            : "w-full max-w-[1580px] bg-background/80 px-2 sm:px-4 lg:px-0"
        }`}
      >
        {/* Left Side: Logo & Grouped Navigation Links */}
        <div className="flex items-center gap-4 lg:gap-6 xl:gap-8 shrink-0">
          <Logo />

          {/* Desktop Navigation Links */}
          <nav className="hidden md:flex items-center lg: xl: absolute left-1/2 -translate-x-1/2 flex items-center justify-center gap-7 lg:gap-8">
            {siteConfig.navLinks.map((link) => (
              <a
                key={link.label}
                href={link.href}
                className="text-sm font-bold text-foreground/80 hover:text-foreground transition-colors duration-150 py-1 whitespace-nowrap"
              >
                {link.label}
              </a>
            ))}
          </nav>
        </div>

        {/* Desktop Right Side: Actions (Theme Toggle, Secondary Pill & Primary Black Pill) */}
        <div className="hidden md:flex items-center gap-3">
          <ThemeToggle />

          <a
            href={siteConfig.links.appStore}
            target="_blank"
            rel="noopener noreferrer"
            className="inline-flex items-center gap-2 px-4 lg:px-5 py-2.5 rounded-full bg-[#F56627] text-white text-sm font-bold hover:bg-[#E05518] shadow-sm transition-all duration-150 select-none active:scale-[0.98] whitespace-nowrap"
          >
            <span>Download for iOS</span>
            <ArrowUpRight className="w-4 h-4" aria-hidden="true" />
          </a>
        </div>

        {/* Mobile Right Controls */}
        <div className="flex md:hidden items-center gap-2">
          <ThemeToggle />
          <button
            type="button"
            onClick={() => setMobileMenuOpen(!mobileMenuOpen)}
            aria-label={mobileMenuOpen ? "Close main menu" : "Open main menu"}
            aria-expanded={mobileMenuOpen}
            className="p-2 rounded-xl bg-surface border border-border text-foreground hover:bg-surface-secondary focus-ring transition-colors"
          >
            {mobileMenuOpen ? (
              <X className="w-5 h-5" />
            ) : (
              <Menu className="w-5 h-5" />
            )}
          </button>
        </div>
      </div>

      {/* Mobile Menu Overlay / Drawer */}
      {mobileMenuOpen && (
        <div
          role="dialog"
          aria-modal="true"
          aria-label="Navigation Menu"
          className="fixed inset-0 z-40 md:hidden bg-background/95 backdrop-blur-lg pt-24 px-6 pb-8 flex flex-col justify-between animate-fadeIn"
        >
          <div className="flex flex-col gap-6 pt-4">
            <nav className="flex flex-col gap-4">
              {siteConfig.navLinks.map((link) => (
                <a
                  key={link.label}
                  href={link.href}
                  onClick={() => setMobileMenuOpen(false)}
                  className="text-xl font-bold text-foreground hover:text-primary py-2 transition-colors border-b border-border/50"
                >
                  {link.label}
                </a>
              ))}
            </nav>
          </div>

          <div className="flex flex-col gap-3 pt-6">
            <a
              href={siteConfig.links.appStore}
              target="_blank"
              rel="noopener noreferrer"
              className="inline-flex items-center justify-center gap-2 w-full py-3.5 px-6 rounded-full bg-[#F56627] text-white text-center font-bold text-base hover:bg-[#E05518] transition-colors"
              onClick={() => setMobileMenuOpen(false)}
            >
              <span>Download for iOS</span>
              <ArrowUpRight className="w-4 h-4" aria-hidden="true" />
            </a>
            <p className="text-center text-xs text-muted pt-2">
              {siteConfig.heroCopy.availability}
            </p>
          </div>
        </div>
      )}
    </header>
  );
}
